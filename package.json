{
  "name": "seventh-reboot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "extract:story": "npx tsx scripts/extract-story-text.ts",
    "import:story": "npx tsx scripts/import-exported-story.mjs",
    "build:bilingual": "npx tsx scripts/build-bilingual-stories.mjs",
    "build:interaction-locales": "npx tsx scripts/build-interaction-locales.mjs",
    "normalize:story-source": "npx tsx scripts/normalize-story-source.ts",
    "test": "npm run test:story-source-format && npm run test:story-audit && npm run validate:story && npm run test:interactions && npm run test:avatar && npm run test:delivery && npm run test:reboot-cycle && npm run test:immersive-story && npm run test:epilogues && npm run test:integrity",
    "test:story-source-format": "npx tsx scripts/test-story-source-format.ts",
    "test:story-audit": "npx tsx scripts/audit-story-vs-source.mjs",
    "validate:story": "npx tsx scripts/validate-story-branches.mjs",
    "test:interactions": "npx tsx scripts/test-special-interactions.ts",
    "test:integrity": "npx tsx scripts/test-game-integrity.ts",
    "test:avatar": "npx tsx scripts/test-avatar-system.ts",
    "test:delivery": "npx tsx scripts/test-delivery-system.ts",
    "test:reboot-cycle": "npx tsx scripts/test-fatal-reboot-cycle.ts",
    "test:immersive-story": "npx tsx scripts/test-immersive-story.ts",
    "test:epilogues": "npx tsx scripts/test-optional-epilogues.ts"
  },
  "dependencies": {
    "lucide-react": "^1.24.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
